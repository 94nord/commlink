# The Laravel API's origin. Expo inlines any EXPO_PUBLIC_* variable into the
# JS bundle at build time — same idea as web/'s VITE_API_URL.
#
# Use the dev stack's HTTP port (8080), not HTTPS (8443): that certificate is
# self-signed and a phone will refuse it.
#
#   iOS simulator             http://localhost:8080
#   Android emulator          http://10.0.2.2:8080   (the host, seen from the VM)
#   Physical device, Expo Go  http://<your-LAN-IP>:8080
#
# A physical device needs the API reachable on the LAN, so the machine running
# the dev stack and the phone must be on the same network.
EXPO_PUBLIC_API_URL=http://localhost:8080
