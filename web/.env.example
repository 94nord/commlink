# The Laravel API's origin — used both to build request URLs and to derive
# the Sanctum CSRF-cookie endpoint (VITE_API_URL + /sanctum/csrf-cookie).
VITE_API_URL=http://localhost:8080

# Reverb (dev only): the browser connects to the host-mapped port directly,
# not through api-dev's nginx. VITE_REVERB_KEY must match server/.env's
# REVERB_APP_KEY.
VITE_REVERB_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8090
VITE_REVERB_SCHEME=http
