# Compose-level variables only (read by docker-compose.yml's ${...}
# substitutions). Laravel's own runtime config lives in server/.env;
# the web app's in web/.env.

DB_DATABASE=client_book
DB_USERNAME=client_book
DB_PASSWORD=change-me

# Host port bindings (override when another project occupies a default):
# DEV_HTTPS_PORT=8443  DEV_HTTP_PORT=8080  DEV_DB_PORT=5432
# DEV_MINIO_PORT=9000  DEV_MINIO_CONSOLE_PORT=9001  DEV_MAILPIT_PORT=8025
# TEST_HTTP_PORT=9080  TEST_WEB_PORT=9081  TEST_DB_PORT=5433  TEST_MAILPIT_PORT=9025

# Isolated test-stack database (Compose profile "test"). Ephemeral and
# local-only; defaults exist in docker-compose.yml so these are optional.
# TEST_DB_DATABASE=client_book_test
# TEST_DB_USERNAME=client_book_test
# TEST_DB_PASSWORD=client-book-test

AWS_ACCESS_KEY_ID=minio-root
AWS_SECRET_ACCESS_KEY=change-me

# Origin the dev web-dev (Vite) service uses to reach the API.
DEV_API_URL=http://localhost:8080

# Prod-only: the public API origin, baked into the web/ build at image build time.
# API_URL=https://api.example.com
