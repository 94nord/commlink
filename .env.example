# Application -----------------------------------------------------------------
# APP_KEY: generate with `php artisan key:generate`. Never commit a real key.
APP_NAME="Inspection Book"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
# Dev stack serves HTTPS on 8443 (self-signed) and HTTP on 8080.
APP_URL=https://localhost:8443

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database --------------------------------------------------------------------
# PostgreSQL everywhere (SQLite in-memory only for PHPUnit, set in phpunit.xml).
# DB_HOST is the Compose service name inside the dev stack; the same port is
# published to the host (5432) for GUI clients. Compose also reads these values
# to provision the local PostgreSQL container.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inspection_book
DB_USERNAME=inspection_book
DB_PASSWORD=change-me

# Host port bindings (override when another project occupies a default):
# DEV_HTTPS_PORT=8443  DEV_HTTP_PORT=8080  DEV_DB_PORT=5432
# DEV_MINIO_PORT=9000  DEV_MINIO_CONSOLE_PORT=9001  DEV_MAILPIT_PORT=8025
# TEST_HTTP_PORT=9080  TEST_DB_PORT=5433  TEST_MAILPIT_PORT=9025

# Isolated test-stack database (Compose profile "test", port 5433). Ephemeral
# and local-only; defaults exist in docker-compose.yml so these are optional.
# TEST_DB_DATABASE=inspection_book_test
# TEST_DB_USERNAME=inspection_book_test
# TEST_DB_PASSWORD=inspection-book-test

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail ------------------------------------------------------------------------
# Dev sends to the Mailpit container (UI at localhost:${DEV_MAILPIT_PORT});
# nothing leaves the machine. Production injects a real transactional
# service (SMTP credentials or an API mailer) via the deployment platform.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage --------------------------------------------------------------
# S3 API in every environment: MinIO locally, a managed bucket in production —
# only these values change, the code path is identical. Compose reuses the
# AWS_* credentials as the MinIO root user. After first dev boot, create the
# bucket named in AWS_BUCKET once via the MinIO console (localhost:9001).
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio-root
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=inspection-book
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Frontend --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# Dev seeding -----------------------------------------------------------------
# Used only by database/seeders/DatabaseSeeder.php in local/dev to create the
# first corporation and admin user. Production provisions customers with
# `php artisan app:create-corporation` instead.
SEED_CORPORATION_NAME="Example Corp"
SEED_USER_NAME="Example Admin"
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=change-me
